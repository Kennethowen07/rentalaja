# Salin jadi .env lalu isi. .env diabaikan git; hanya file ini yang di-commit.
#
# Cara cepat membuat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Kata sandi Postgres di container. Dipakai docker-compose.yml DAN
# DATABASE_URL di bawah, jadi keduanya harus sama.
DB_PASSWORD=ganti-dengan-nilai-acak

# Port 5433, sesuai docker-compose.yml.
DATABASE_URL=postgresql://rentalaja:ganti-dengan-nilai-acak@localhost:5433/rentalaja

# Kunci penandatangan token login. Minimal 32 karakter acak. Mengubahnya
# membuat semua token yang sudah terbit tidak berlaku lagi.
JWT_SECRET=ganti-dengan-nilai-acak-minimal-32-karakter

PORT=4000
