# Frontend ini belum butuh environment variable apa pun.
#
# Peta memakai OpenStreetMap + Leaflet tanpa API key (lihat
# components/ui/PetaLokasi.tsx dan docs/TECH_DEBT.md K1). Variabel lama
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY sudah tidak dipakai.

# Alamat rentalaja-api (folder ../rentalaja-api), mis. http://localhost:4000.
# Hanya dibaca di server (tanpa awalan NEXT_PUBLIC_), jadi tidak pernah ikut
# terkirim ke browser.
#
# Dibiarkan kosong = semua halaman memakai data contoh di lib/mock/, sama
# seperti sebelum backend ada. Itu yang dipakai deploy Vercel selama
# rentalaja-api belum di-deploy.
API_URL=

# Kata sandi akun demo (penyewa.demo@rentalaja.test dan
# mitra.demo@rentalaja.test), sama dengan PASSWORD_DEMO di rentalaja-api/.env.
# Hanya dibaca server untuk tombol "Masuk sebagai ... demo" di modal masuk;
# tidak pernah dikirim ke browser. Kosong = tombolnya tidak tampil.
PASSWORD_DEMO=
